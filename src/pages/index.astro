---
import { ApplyForm } from "@/components/apply/applyForm";
import { LogoMark } from "@/components/apply/logoMark";
import { BRANDS } from "@/lib/brands";
import "@/styles/global.css";

const looks = BRANDS.map(({ name, domains, theme }) => ({ name, domains, theme }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Apply</title>
    <script is:inline define:vars={{ looks }}>
      // Runs before the page paints, so the right brand and language show from the start.
      const host = location.hostname.toLowerCase();
      const brand =
        looks.find((b) => b.domains.some((d) => host === d || host.endsWith("." + d))) ?? looks[0];
      const root = document.documentElement;
      const t = brand.theme;
      root.style.setProperty("--brand-primary", t.primary);
      root.style.setProperty("--brand-primary-hover", t.primaryHover);
      root.style.setProperty("--brand-primary-tint", t.primaryTint);
      root.style.setProperty("--brand-title-accent", t.titleAccent);
      root.style.setProperty("--brand-step", t.step);
      root.style.setProperty("--brand-background", t.background);
      root.style.setProperty("--brand-field-radius", t.fieldRadius);
      root.style.setProperty("--brand-font", t.font);
      document.title = "Apply · " + brand.name;
      if (new URLSearchParams(location.search).get("lang") === "fr") root.lang = "fr";
    </script>
  </head>
  <body>
    <!-- One loader in the middle until the form, logo and photo are ready. It uses the brand's
         colors, which the script above set before the page paints. -->
    <div class="page-loader" role="status" aria-label="Loading"><span></span></div>
    <div class="shell">
      <aside class="hero">
        <!-- Phones don't show the photo, so they don't download it either. -->
        <picture>
          <source media="(max-width: 999px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACw=" />
          <img class="art" src="/left-panel-photo.webp" alt="" width="1024" height="1536" onload="this.dataset.in=''" onerror="this.dataset.in=''" />
        </picture>
        <LogoMark />
        <p class="eyebrow">
          <span data-only="en">Personal loan</span>
          <span data-only="fr">Prêt personnel</span>
        </p>
        <h2>
          <span data-only="en">Start Your<span>Application</span></span>
          <span data-only="fr">Commencez votre<span>demande</span></span>
        </h2>
      </aside>

      <ApplyForm client:load />
    </div>
  </body>
</html>
