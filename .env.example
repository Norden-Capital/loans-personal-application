# The settings this form needs. Real values go in Vercel's settings, never in this repo.

# The LMS's address, and the secret that proves the form is calling it (same value as on the LMS server).
LMS_URL=
PROXY_SECRET=

# Cloudflare Turnstile, the spam check. The site key is public; the secret key is not.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
